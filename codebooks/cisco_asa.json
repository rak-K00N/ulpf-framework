    },
    {
      "code": "302014",
      "description": "Connection teardown",
      "action": "other",
      "event_type": "connection",
      "regex": "Teardown (?P<protocol>\\w+) connection (?P<conn_id>\\d+) for \\w+:(?P<src_ip>[\\d.]+)/(?P<src_port>\\d+) to \\w+:(?P<dst_ip>[\\d.]+)/(?P<dst_port>\\d+) duration (?P<duration>[\\d:]+) bytes (?P<bytes>\\d+)"
    },
    {
      "code": "106023",
      "description": "Denied by access-group",
