      "event_type": "traffic",
      "regex": "Deny (?P<protocol>\\w+) src \\w+:(?P<src_ip>[\\d.]+)/(?P<src_port>\\d+) dst \\w+:(?P<dst_ip>[\\d.]+)/(?P<dst_port>\\d+) by access-group \"(?P<acl>[^\"]+)\""
    },
    {
